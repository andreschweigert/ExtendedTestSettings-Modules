<!-- language file start -->
title#:#Network quality measurement
description#:#Client-side latency and packet-loss measurement, correlates complaints with real network events
enable#:#Enable network quality measurement
enable_info#:#Measures RTT (and optionally packet loss) in the background. Stores network events for later correlation with complaints. No visible interference with the test player.
interval_label#:#Measurement interval
interval_5#:#5 s (fine-grained, more load)
interval_10#:#10 s (default)
interval_30#:#30 s (economical)
rtt_warn_label#:#RTT warning threshold (ms)
rtt_warn_info#:#Exceeded → event "degraded" stored.
rtt_crit_label#:#RTT critical threshold (ms)
rtt_crit_info#:#Exceeded → event "critical" stored.
loss_enable#:#Enable packet-loss measurement
loss_enable_info#:#Sends N parallel HEAD requests, counts failures as simulated packet loss.
loss_probes_label#:#Number of parallel probes
loss_probes_info#:#2–10 parallel probes. Each probe = 1 HEAD request.
