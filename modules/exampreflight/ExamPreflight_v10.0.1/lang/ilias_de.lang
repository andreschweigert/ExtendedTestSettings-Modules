th_date#:#Datum
th_user#:#Geprüft von
th_status#:#Status
th_questions#:#Fragen
th_findings#:#Befunde
status_running#:#läuft noch
status_completed#:#abgeschlossen
status_aborted#:#abgebrochen
run_detail_heading#:#Lauf #%d — Ergebnisse pro Frage
run_still_running#:#Dieser Lauf ist noch nicht abgeschlossen — Ergebnisse können unvollständig sein.
testdata_note#:#Hinweis: Der Preflight-Durchlauf erzeugt einen normalen Testlauf für das prüfende Konto. Diesen vor Prüfungsbeginn unter „Teilnehmerdaten" löschen.
run_deleted#:#Lauf gelöscht.
confirm_delete_run#:#Diesen Lauf inklusive aller Screenshots löschen?
