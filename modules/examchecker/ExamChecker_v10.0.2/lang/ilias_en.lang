chk_nur_ausgewaehlte_teilnehmer#:#Selected participants only
chk_nur_ausgewaehlte_teilnehmer_info#:#Restricts access to an invited list of participants.
chk_vorbedingungen#:#Preconditions for test access
chk_vorbedingungen_info#:#Preconditions can keep individual participants from starting.
chk_startzeit_aktiviert#:#Start time enabled
chk_startzeit_aktiviert_info#:#The test cannot be started before this point in time.
chk_endzeit_aktiviert#:#End time enabled
chk_endzeit_aktiviert_info#:#The test can no longer be started after this point in time.
chk_pruefungszeitraum#:#Exam period
chk_pruefungszeitraum_info#:#Please verify for plausibility — a general target value is not possible here.
chk_testdurchlaeufe_begrenzen#:#Number of attempts
chk_testdurchlaeufe_begrenzen_info#:#0 means an unlimited number of attempts.
chk_wartezeit_erzwingen#:#Waiting period between attempts
chk_wartezeit_erzwingen_info#:#Forces a pause before another attempt is possible.
chk_pruefungsansicht#:#Exam view (kiosk mode)
chk_pruefungsansicht_info#:#Hides the ILIAS navigation during the exam.
chk_automatisches_speichern#:#Automatic saving
chk_automatisches_speichern_info#:#Saves answers regularly without participant action.
chk_autosave_intervall#:#Automatic saving interval
chk_autosave_intervall_info#:#Only meaningful when automatic saving is enabled.
chk_direkte_rueckmeldung#:#Instant feedback during the test
chk_direkte_rueckmeldung_info#:#Shows participants during the exam whether an answer was correct.
chk_fragen_markieren#:#Mark questions
chk_fragen_markieren_info#:#Participants can mark questions for later review.
chk_eigenstaendigkeitserklaerung#:#Require confirmation of exam conditions
