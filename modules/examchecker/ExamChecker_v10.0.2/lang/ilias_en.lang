chk_bearbeitungsdauer#:#Limit processing time
chk_bearbeitungsdauer_info#:#Limits the time available from the start of an attempt.
chk_bearbeitungsdauer_minuten#:#Processing time
chk_bearbeitungsdauer_minuten_info#:#Must match the actual exam duration — please verify manually.
chk_bewertungssystem#:#Scoring of partially correct answers
